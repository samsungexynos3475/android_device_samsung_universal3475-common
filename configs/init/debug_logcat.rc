on early-init
    # Enable ADB Debugging By Default
    setprop persist.adb.notify 0
    setprop persist.service.adb.enable 1
    setprop persist.service.debuggable 1
    setprop persist.sys.usb.config mtp,adb
    setprop ro.debuggable 1
    setprop ro.secure 0
    setprop service.adb.root 1

on post-fs-data
    # Clean up all old logs to prevent storage from filling up over multiple reboots
    rm /data/local/tmp/logcat.txt
    start logcat_dump

service logcat_dump /system/bin/sh -c "exec logcat -b all -f /data/local/tmp/logcat.txt"
    user root
    group root log
    seclabel u:r:su:s0
    disabled

service sync_dump /system/bin/sh -c "while true; do sync; sleep 2; done"
    class core
    user root
    group root
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    stop logcat_dump
    stop sync_dump
